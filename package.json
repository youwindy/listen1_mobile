{
  "name": "listen1-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Listen1 Mobile — 多平台音乐播放器（React Native 0.87 + TypeScript）",
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:android:debug": "cd android && gradlew.bat assembleDebug",
    "build:android:release": "cd android && gradlew.bat assembleRelease",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/slider": "^5.2.1",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@shopify/flash-list": "^2.3.3",
    "crypto-js": "^4.2.0",
    "html-entities": "^2.6.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.29.0",
    "react-native-track-player": "^4.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/app/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/legacy/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/legacy/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:@react-native|react-native|@react-navigation|react-native-track-player|@react-native-vector-icons|@shopify/flash-list|react-native-gesture-handler|react-native-safe-area-context|react-native-screens|zustand)/)"
    ]
  }
}
